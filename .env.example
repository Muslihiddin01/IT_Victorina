# Скопируй этот файл в .env.local и впиши свои данные.
# На Vercel эти же переменные добавляются в Settings → Environment Variables.

# Логин и пароль учителя (админа)
ADMIN_LOGIN=Muslihiddin
ADMIN_PASSWORD=придумай-надёжный-пароль
ADMIN_NAME=Муслихиддин

# Адрес базы Postgres. На Vercel его добавляет Neon сам.
# Локально можно не указывать — тогда база создастся в папке .data/
# DATABASE_URL=postgres://...

# Часовой пояс для времени в CSV-файле с результатами
TIMEZONE=Asia/Dushanbe

# Необязательно: почта для бесплатного переводчика MyMemory (кнопка «Перевести на таджикский»).
# Без неё лимит около 5000 символов в день, с ней — 50 000.
# MYMEMORY_EMAIL=you@example.com
